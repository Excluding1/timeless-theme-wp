# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored, never commits secrets.

# Google Places Autocomplete API key (optional — form falls back to plain
# text input if missing).
#
# How to get one:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a new project (or use existing) → Create credentials → API key
#   3. Enable APIs: "Places API (New)"
#   4. Restrict the key:
#      - HTTP referrer restriction: timelessresurfacing.com.au/* + localhost:5173/*
#      - API restriction: Places API (New) only
#   5. Paste the key below.
#
# Pricing: Autocomplete sessions are FREE since Nov 2024 with session tokens
#          (we already use them). $200 free monthly credit covers ~50,000 sessions.
VITE_GOOGLE_PLACES_KEY=

# GHL webhook security gate token (W1/W2 Action 1 If/Else default-deny validates this).
# Source: day_4_w1_w2_build_2026-05-18.md:32-45 + day8-react-form-prep-plan-2026-05-20.md §4.
# Rotation: quarterly OR on suspected exposure.
# On rotation: update W1+W2 Action 1 Security Gate condition in GHL UI to match.
#
# How to generate a real value:
#   echo "TR_secret_v2_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
VITE_GHL_SECRET_TOKEN=

# Cloudinary photo upload (Phase 1 unsigned architecture).
# Source: cloudinary-plan-2026-05-21.md §1-§2.
#
# How to set up:
#   1. Sign up at https://cloudinary.com/users/register_free
#      (use admin@timelessresurfacing.com.au)
#   2. Copy "Cloud name" from dashboard URL or Settings → Account
#   3. Create unsigned upload preset (Settings → Upload → Add upload preset):
#      - Name: timeless-form-photos
#      - Signing mode: UNSIGNED
#      - Folder: timeless-quotes
#      - Allowed formats: jpg,jpeg,png,heic,heif,webp
#      - Max file size: 10000000 (10 MB)
#      - Public ID: Auto-generate unguessable
#      - Display name: Last segment of public ID
#      - Transformations: c_limit,w_1920,h_1920,q_auto:good,f_auto,fl_strip_profile
#   4. Paste the cloud name + preset name below.
#
# Phase 2 upgrade (signed uploads via backend signer): triggered at 50+ leads/mo
# OR first abuse incident. Requires Cloud Function build + adds VITE_CLOUDINARY_API_KEY.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
