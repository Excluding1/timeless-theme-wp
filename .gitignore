# Build artifacts (compiled CSS is committed, but source maps etc. shouldn't be)
*.map

# Dependencies
node_modules/
quote-form/node_modules/
quote-form/dist/
quote-form/.env
quote-form/.env.local
quote-form/.env.production

# Dev tool artifacts (not part of the theme)
.claude/
.playwright-mcp/

# CEO Cockpit — runtime config pastes (may hold business config; keep local, never commit)
cockpit/data/config/

# OS / Editor
.DS_Store
*.swp
.vscode/
.idea/

# Stray screenshots — dev-time, never deploy
# All screenshots should go in .claude/screenshots/ (already gitignored above).
# These root-level patterns catch the case where someone drops one at the top.
*.png.dev
homepage-*.png
vanity-*.png
thesis-*.png
live-*.png
localhost-*.png
*-screenshot.png
*-fullsize.png

# Logs
npm-debug.log*
*.log

# Responsive image variants — derived artifacts, regenerable via:
#   python3 scripts/generate-responsive-images.py
# Kept on disk for the deploy zip but excluded from git history to avoid
# committing ~25 MB of binary blobs that are deterministic outputs of the
# script. Pattern matches files like image-400w.jpg.webp, image-800w.png, etc.
images/**/*-[0-9]*w.jpg
images/**/*-[0-9]*w.jpeg
images/**/*-[0-9]*w.png
images/**/*-[0-9]*w.jpg.webp
images/**/*-[0-9]*w.jpeg.webp
images/**/*-[0-9]*w.png.webp

# Deploy zip artifacts (zips of the theme go to ../timeless-theme.zip outside repo)
*.zip

# Local secrets (API keys) — never commit, never deploy
.secrets/

# Stray root deno.lock (the canonical lock lives in contractor-app/supabase/functions/)
/deno.lock
contractor-app/supabase/.temp/
docs/quote-app/config.js

# Task Hub credentials. docs/task-hub/ became tracked on 2026-08-22 (its server.js
# had been lost precisely because the directory was untracked), and config.js there
# holds the Supabase project URL + anon key. Ignore it so restoring the app never
# commits the keys with it.
docs/task-hub/config.js
docs/task-hub/reminders.json

# AI-generated blog images (illustrative only) — stay OUT of git; live copies go via Media Library
images/blog/
quote-inbox/data/reviewed.json
