#!/bin/bash
# Pre-commit hook — Timeless Theme regression detector
# Activated 2026-05-05 after 138-class Tailwind v4 migration regression + slider bugs

set -eu

ERR=0
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Get list of staged files
ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)

# Files that get pattern-checked: PHP/JS source — NOT docs (which contain "what NOT to do" examples), NOT compiled CSS
SOURCE_FILES=$(echo "$ALL_STAGED" | grep -E '\.(php|js)$' | grep -vE '^(assets/main\.min\.css|src/main\.css|.*\.min\.(css|js)$)' | grep -vE '^(CLAUDE|README|HANDOFF|WORKFLOW|BUILD|CHANGELOG|.*\.md)$' | grep -vE '\.md$' || true)
PHP_FILES=$(echo "$SOURCE_FILES" | grep -E '\.php$' || true)

if [ -z "$ALL_STAGED" ]; then
  echo "✅ No files staged."
  exit 0
fi

echo "🔍 Pre-commit checks on $(echo "$SOURCE_FILES" | grep -c . || echo 0) source file(s) (excludes docs + compiled output)..."

check_pattern() {
  local pattern="$1"
  local label="$2"
  local files="$3"
  local severity="${4:-FAIL}"
  
  [ -z "$files" ] && return 0
  
  local matches
  matches=$(echo "$files" | xargs -I {} grep -lE "$pattern" {} 2>/dev/null || true)
  
  [ -z "$matches" ] && return 0
  
  if [ "$severity" = "FAIL" ]; then
    echo -e "${RED}❌ FAIL: $label${NC}"
    echo "$matches" | head -3 | while read -r f; do
      [ -z "$f" ] && continue
      grep -nE "$pattern" "$f" 2>/dev/null | head -2 | sed "s|^|  $f:|"
    done
    ERR=1
  else
    echo -e "${YELLOW}⚠️  WARN: $label${NC}"
    echo "$matches" | head -3 | sed 's|^|  |'
  fi
}

# Tailwind v3 negative-arbitrary-value syntax
check_pattern '(mt|ml|mr|mb|mx|my|top|left|right|bottom)-\[-[0-9]' \
  "Tailwind v3 negative-arbitrary syntax. Use '-mt-[X]' (negative outside brackets)." \
  "$SOURCE_FILES"

# v3 gradient class
check_pattern 'class="[^"]*bg-gradient-to-' \
  "Tailwind v3 'bg-gradient-to-*' in template. Use 'bg-linear-to-*' (v4)." \
  "$SOURCE_FILES"

# Section 2B 'width:X%' broken clip pattern
check_pattern 'class="ba-clip[^"]*"[^>]*style="width:[0-9]+%' \
  "Section 2B slider 'width:X%' compresses BEFORE image. Use 'clip-path:inset(0 [100-X]% 0 0)'." \
  "$PHP_FILES"

# Hardcoded enqueue version
check_pattern "wp_enqueue_(script|style)\([^)]*'1\.0\.0'" \
  "Hardcoded '1.0.0' in wp_enqueue. Use filemtime() for proper cache-bust." \
  "$PHP_FILES"

# w-0.5 / h-0.5 — warning only
check_pattern '(class=|"\W)(w-0\.5|h-0\.5)(\s|"|/)' \
  "w-0.5 / h-0.5 — prefer w-[2px] / h-[2px] for guaranteed v4 compilation." \
  "$PHP_FILES" "WARN"

# space-x-* / space-y-* on flex containers — uses :where() (specificity 0) which
# loses cascade ties to preflight `* { margin: 0 }` in v4. Use gap-* instead.
# (Negative -space-x-* for stacked profile-pic overlap is OK — no preflight conflict.)
check_pattern 'class="[^"]*\Wflex[^"]*\Wspace-(x|y)-[0-9]' \
  "space-x-/space-y- on flex container loses cascade in v4. Use gap-* instead." \
  "$PHP_FILES" "WARN"

# Stray dev screenshots staged
SCREENSHOT_STAGED=$(echo "$ALL_STAGED" | grep -E '^(live-|localhost-|homepage-|vanity-|thesis-).*\.png$' || true)
if [ -n "$SCREENSHOT_STAGED" ]; then
  echo -e "${RED}❌ FAIL: Dev screenshot in repo root. Move to .claude/screenshots/.${NC}"
  echo "$SCREENSHOT_STAGED" | head -3 | sed 's|^|  |'
  ERR=1
fi

# .env files staged
ENV_STAGED=$(echo "$ALL_STAGED" | grep -E '\.env$' | grep -v '\.env\.example$' || true)
if [ -n "$ENV_STAGED" ]; then
  echo -e "${RED}❌ FAIL: .env file staged. Only .env.example should be tracked.${NC}"
  echo "$ENV_STAGED" | sed 's|^|  |'
  ERR=1
fi

# .zip files staged
ZIP_STAGED=$(echo "$ALL_STAGED" | grep -E '\.zip$' || true)
if [ -n "$ZIP_STAGED" ]; then
  echo -e "${RED}❌ FAIL: .zip file staged. Deploy zips go OUTSIDE the repo.${NC}"
  ERR=1
fi

if [ $ERR -eq 0 ]; then
  echo -e "${GREEN}✅ All pre-commit checks passed.${NC}"
fi

exit $ERR
